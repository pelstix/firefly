# ─────────────────────────────────────────────────────────────────────────────
# .env.example – copy to .env and edit as needed
# All values have sensible defaults; only override when necessary.
# ─────────────────────────────────────────────────────────────────────────────

# Service location
API_BASE_URL=http://localhost:8080

# Test user credentials (pre-populated by the service)
USER1_NAME=test1
USER1_PASSWORD=test123
USER2_NAME=test2
USER2_PASSWORD=test456

# Timeouts
REQUEST_TIMEOUT=10
SERVICE_STARTUP_TIMEOUT=60

# Load test parameters
LOAD_TEST_USERS=20
LOAD_TEST_SPAWN_RATE=10
LOAD_TEST_DURATION=60s
LOAD_TEST_MIN_RPS=16.67
LOAD_TEST_MAX_FAILURE_RATE=0.01
LOAD_TEST_MAX_P95_MS=500

# Reporting
REPORT_DIR=reports
ENVIRONMENT=local
